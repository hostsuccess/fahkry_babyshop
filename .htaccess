Options +FollowSymLinks -MultiViews
RewriteEngine On

# 1. Jika user nekat mengetik .php di URL, paksa redirect ke versi bersih tanpa .php
# Kode ini otomatis menjaga parameter query (?kategori=...) tetap aman
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L,QSA]

# 2. Di balik layar, arahkan URL tanpa .php ke file asli .php-nya
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [NC,L,QSA]